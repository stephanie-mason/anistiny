---
import BaseLayout from "./BaseLayout.astro";
import { getImage, Image } from "astro:assets";
const { frontmatter } = Astro.props;
const coverHref = (await getImage({ src: frontmatter.cover })).src;
const imageHrefs = await Promise.all(
    (frontmatter.images ?? []).map(async (image) => (await getImage({ src: image })).src),
);
---

<BaseLayout pageTitle={frontmatter.title}>
    <p>
        <em
            >{
                new Date(frontmatter.date).toLocaleDateString("en-US", {
                    month: "long",
                    year: "numeric",
                })
            }</em
        ><br />
        {frontmatter.materials}, {frontmatter.dimensions}
        <slot />
    </p>

    <div class="cover-image">
        <a class="img-link" href={coverHref}>
            <Image
                src={frontmatter.cover}
                alt={frontmatter.cover_alt}
                id="coverImage"
            />
        </a>
    </div>

    <div class="more-images">
        {
            frontmatter.images?.map((image, index) => (
                <a class="img-link" href={imageHrefs[index]}>
                    <Image
                        src={image}
                        alt={frontmatter.image_alts?.[index] ?? ""}
                    />
                </a>
            ))
        }
    </div>
</BaseLayout>

<style>
    .img-link {
        text-decoration: none;
    }
    .img-link:hover,
    .img-link:focus,
    .img-link:active {
        background: unset;
        transform: none;
    }

    .cover-image {
        display: grid;
        margin-bottom: var(--space--sm);
    }
    .cover-image img {
        max-width: 100%;
        height: unset;
        grid-row: 1 / span 1;
        grid-column: 1 / span 1;
        transition: opacity 0.5s;
    }
</style>
