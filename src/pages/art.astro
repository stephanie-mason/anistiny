---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";

const pageTitle = "Gallery";
const allProjects = await getCollection("projects");
let { projects, featured } = Astro.props;

projects = allProjects
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
featured = allProjects.filter((project) =>
    project.data.categories.includes("featured"),
);
---

<BaseLayout pageTitle={pageTitle}>
    <div class="cards">
        {
            projects.map((project) => {
                const year = project.data.date.getFullYear();
                const month = project.data.date.getMonth();
                const fullMonth = [
                    "January",
                    "February",
                    "March",
                    "April",
                    "May",
                    "June",
                    "July",
                    "August",
                    "September",
                    "October",
                    "November",
                    "December",
                ];
                return (
                    <Card
                        title={project.data.title}
                        href={`/projects/${project.id}/`}
                        image={project.data.cover}
                        image_alt={project.data.cover_alt}
                    >
                        <p class="no-margin">
                            {fullMonth[month]} {year}
                        </p>
                        <p class="no-margin">
                            {project.data.materials} {project.data.dimensions}
                        </p>
                    </Card>
                );
            })
        }
    </div>

    <style>
    </style>
</BaseLayout>
