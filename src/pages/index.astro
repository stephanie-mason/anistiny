---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import { Image } from "astro:assets";
import stefPic from "../images/stef-2025.webp";

const pageTitle = "Art by Anistiny";
const allProjects = await getCollection("projects");
let { projects, featured } = Astro.props;

projects = allProjects
	.sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
	.slice(0, 5);
featured = allProjects.filter((project) =>
	project.data.categories.includes("featured"),
);
---

<BaseLayout pageTitle={pageTitle}>
	<div class="intro">
		<Image
			src={stefPic}
			alt="Stephanie Paulantis with bright pink flowers in her hair"
			width="650"
		/>

		<p>Hi There!</p>
	</div>

	<h2>Recent Art</h2>
	<div class="cards">
		{
			projects.map((project) => {
				const year = project.data.date.getFullYear();
				const month = project.data.date.getMonth();
				const fullMonth = [
					"January",
					"February",
					"March",
					"April",
					"May",
					"June",
					"July",
					"August",
					"September",
					"October",
					"November",
					"December",
				];
				return (
					<Card
						title={project.data.title}
						href={`/projects/${project.slug}/`}
						image={project.data.cover}
						image_alt={project.data.cover_alt}
					>
						<p>
							{fullMonth[month]} {year}
						</p>
						<p>
							{project.data.materials} {project.data.dimensions}
						</p>
					</Card>
				);
			})
		}
	</div>

